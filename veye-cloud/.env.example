API_HOST=0.0.0.0
API_PORT=6006

# start_all_venv.sh：是否与 API 一并启动 Vite 开发服（6008，日志 logs/vite.log）。需 Node>=18；设为 0 可关闭
# START_VITE_FRONTEND=1
API_KEY=change-me-to-a-long-random-string

# 浏览器跨域调 API 时使用，逗号分隔多个 Origin，例如：http://localhost:5173,https://example.com
# CORS_ALLOW_ORIGINS=

# --- AutoDL 容器 Pro：可选，用于 start_all_venv.sh 每次启动自动拉取 6006 反代公网地址并同步 Android ---
# AUTODL_TOKEN=在 www.autodl.com 控制台 → 账号 → 设置 → 开发者 Token
# AUTODL_PRO_INSTANCE_UUID=控制台「实例详情」实例 ID，原样（可选；不填时仅当「运行中」实例恰好 1 个才自动推断）
# AUTODL_FETCH_BASE_URL=1  在未设置 AUTODL_TOKEN 时仍尝试拉取（用于 scripts/fetch_autodl_pro_6006_base_url.py 内 _EMBEDDED_* 填 Token 的场景）
# AUTODL_DISABLE_AUTO_INSTANCE_UUID=1  禁止 list 自动推断，必须填写实例 ID
# AUTODL_SNAPSHOT_RETRIES=8
# AUTODL_SNAPSHOT_RETRY_SECS=3

VLLM_BASE_URL=http://127.0.0.1:8001
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_USE_V1=1
# 调用 vLLM 的读超时（秒）；容器/K8s 内需保证 VLLM_BASE_URL 从 API 进程可达（勿误用仅宿主机可见的 127.0.0.1）
VLLM_HTTP_TIMEOUT_S=180

# 工作报告：纯文本 LLM（port 8002，与识图 VL 8001 互斥调度）
REPORT_VLLM_BASE_URL=http://127.0.0.1:8002
REPORT_VLLM_MODEL=/root/autodl-tmp/.cache/modelscope/models/Qwen/Qwen2.5-7B-Instruct
REPORT_VLLM_MAX_MODEL_LEN=8192
REPORT_VLLM_MAX_OUTPUT_TOKENS=2048
REPORT_VLLM_GPU_MEMORY_UTILIZATION=0.28
MODEL_SWITCH_TIMEOUT_S=120
REPORT_TIMEZONE=Asia/Shanghai

DATABASE_URL=postgresql+psycopg://veye:veye_password@127.0.0.1:5432/veye

IMAGE_DIR=/data/veye/images
TILE_CACHE_DIR=/data/veye/tiles
MAX_IMAGE_BYTES=104857600

# 地图瓦片：start_all_venv.sh 阻塞预热 street+amap（TILE_WARM_MODE=fast|full）
# START_TILE_WARM=1
# TILE_WARM_MODE=fast
# BUILD_WEB_UI=1
# TILE_WARM_SPAN=0.22

# Web 用户 JWT 鉴权（生产环境务必改为长随机字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168
